{
  "name": "@pdf-editor/spike-m0",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "M0 Day 1 technical validation spike (text replacement, Korean font embedding, save method, memory). To be cleaned up after M0 ends.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "spike": "node dist/cli.js",
    "fixtures": "node dist/cli.js --write-fixtures",
    "spike:xobject": "node dist/cli.js --xobject",
    "spike:redact": "node dist/cli.js --redact-existing",
    "spike:save-bench": "node dist/cli.js --save-bench",
    "spike:corpus": "node dist/cli.js --corpus",
    "spike:pdfjs": "node dist/cli.js --pdfjs",
    "spike:objstms": "node dist/cli.js --objstms"
  },
  "dependencies": {
    "@pdf-editor/core": "workspace:*",
    "@pdf-editor/pdf-ops": "workspace:*",
    "@pdf-editor/shared-types": "workspace:*",
    "mupdf": "1.28.1"
  },
  "devDependencies": {
    "pdfjs-dist": "6.4.299"
  }
}

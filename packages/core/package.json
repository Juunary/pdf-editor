{
  "name": "@pdf-editor/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./bench": {
      "types": "./dist/bench-memory.d.ts",
      "default": "./dist/bench-memory.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@pdf-editor/layout-recon": "workspace:*",
    "@pdf-editor/pdf-ops": "workspace:*",
    "@pdf-editor/reflow": "workspace:*",
    "@pdf-editor/shared-types": "workspace:*",
    "comlink": "4.4.2",
    "mupdf": "1.28.1"
  },
  "devDependencies": {
    "pdfjs-dist": "6.4.299"
  }
}
